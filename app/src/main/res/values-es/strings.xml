    <string name="attitude_1_name">No Juzgar</string>
    <string name="attitude_1_desc">Observa tus pensamientos y emociones sin etiquetarlos como buenos o malos.</string>
    <string name="attitude_2_name">Paciencia</string>
    <string name="attitude_2_desc">Deja que las cosas sucedan a su propio ritmo, sin apresurar el momento.</string>
    <string name="attitude_3_name">Aceptación</string>
    <string name="attitude_3_desc">Reconoce y acoge el momento presente exactamente como es.</string>
    <string name="attitude_4_name">Mente de Principiante</string>
    <string name="attitude_4_desc">Mira cada experiencia como si fuera la primera vez, con curiosidad.</string>
    <string name="attitude_5_name">Confianza</string>
    <string name="attitude_5_desc">Confía en ti, en tu intuición y en lo que sientes.</string>
    <string name="attitude_6_name">No Esfuerzo</string>
    <string name="attitude_6_desc">Abandona la necesidad constante de alcanzar un resultado inmediato.</string>
    <string name="attitude_7_name">Soltar</string>
    <string name="attitude_7_desc">Suelta aquello a lo que te aferras y permite que las experiencias simplemente sean.</string>
    <string name="attitude_8_name">Gratitud</string>
    <string name="attitude_8_desc">Aprecia las cosas simples que sostienen tu vida cada día.</string>
    <string name="attitude_9_name">Generosidad</string>
    <string name="attitude_9_desc">Ofrece tu presencia, tu tiempo y tu amabilidad sin esperar nada a cambio.</string>
