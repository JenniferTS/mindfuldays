    <string name="attitude_1_name">Non-Judging</string>
    <string name="attitude_1_desc">Observe your thoughts and feelings without labeling them as good or bad.</string>
    <string name="attitude_2_name">Patience</string>
    <string name="attitude_2_desc">Let things unfold in their own time, without rushing the moment.</string>
    <string name="attitude_3_name">Acceptance</string>
    <string name="attitude_3_desc">Recognize and embrace the present moment exactly as it is.</string>
    <string name="attitude_4_name">Beginner’s Mind</string>
    <string name="attitude_4_desc">Look at each experience as if it were the first time, with curiosity.</string>
    <string name="attitude_5_name">Trust</string>
    <string name="attitude_5_desc">Trust yourself, your intuition and your own feelings.</string>
    <string name="attitude_6_name">Non-Striving</string>
    <string name="attitude_6_desc">Let go of the constant need to reach an immediate result.</string>
    <string name="attitude_7_name">Letting Go</string>
    <string name="attitude_7_desc">Release what you cling to and allow experiences to simply be.</string>
    <string name="attitude_8_name">Gratitude</string>
    <string name="attitude_8_desc">Appreciate the simple things that sustain your life every day.</string>
    <string name="attitude_9_name">Generosity</string>
    <string name="attitude_9_desc">Offer your presence, time and kindness without expecting anything in return.</string>
